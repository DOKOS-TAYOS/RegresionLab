{
  "name": "regressionlab-desktop",
  "private": true,
  "version": "1.1.2",
  "description": "Electron desktop frontend for RegressionLab",
  "main": "dist-electron/electron/main.js",
  "engines": {
    "node": ">=22.22.2"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\" \"npm:dev:app\"",
    "dev:renderer": "vite",
    "dev:electron": "tsc -p electron.tsconfig.json --watch --preserveWatchOutput",
    "dev:app": "wait-on tcp:5173 file:dist-electron/electron/main.js && electron dist-electron/electron/main.js --dev-server-url=http://localhost:5173",
    "ensure-build": "node scripts/ensure-build.mjs",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "tsc -p electron.tsconfig.json",
    "start": "npm run ensure-build && npm run start:raw",
    "start:raw": "electron dist-electron/electron/main.js",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "electron": "^43.0.0",
    "plotly.js-dist-min": "^3.5.1",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-plotly.js": "^4.0.0",
    "react-router-dom": "^7.15.1",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.2.0",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^6.0.2",
    "concurrently": "^10.0.3",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.0.13",
    "vitest": "^4.1.7",
    "wait-on": "^9.0.10"
  }
}
